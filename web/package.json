{
  "name": "votoclaro-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "types:analisis": "json2ts -i lib/schema/analisis.schema.json -o lib/schema/analisis.ts --no-additionalProperties --bannerComment \"/* Generado desde pipeline/src/votoclaro/models.py (vc schema). No editar a mano. */\"",
    "dev:preview": "node scripts/sync-assets.mjs && node scripts/dev-preview.mjs",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "db:sync": "tsx scripts/db-sync.mts",
    "build:scripts": "esbuild scripts/db-migrate.mts scripts/db-sync.mts --bundle --platform=node --format=esm --target=node24 --outdir=scripts/dist --out-extension:.js=.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --external:@electric-sql/pglite --external:@electric-sql/pglite-pgvector",
    "evals": "tsx scripts/evals.mts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@ai-sdk/react": "^4.0.131",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ai": "^7.0.128",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "nuqs": "^2.10.1",
    "pdfjs-dist": "^6.4.299",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
