# COPIA (no renombres) este fichero a .env y rellena los valores. NUNCA subas .env al repo.
# En producción, estas variables se configuran en Railway (servicio web) y GitHub Secrets (CI).

# --- OpenAI ---
OPENAI_API_KEY=
# Los modelos y precios están en config/models.env (versionado, no secreto).
# Solo si quieres sobrescribirlos en local, descomenta y rellena:
# OPENAI_MODEL_ANALYSIS=
# OPENAI_MODEL_CHAT=
# OPENAI_MODEL_FAST=
# OPENAI_EMBEDDING_MODEL=

# --- Base de datos del chat ---
# En local: PGlite (Postgres dentro de Node, sin Docker), relativo a web/.
# En Railway: la URL del Postgres con pgvector (variable de referencia ${{Postgres.DATABASE_URL}}).
DATABASE_URL=pglite:./.pglite
# Activa el chat (1) cuando la base de datos y la clave estén listas
CHAT_ACTIVO=1
# Opcional: token para que los evals no cuenten en los límites por persona
CHAT_EVALS_TOKEN=

# --- Chat: uso justo y coste (spec 004) ---
# Preguntas gratis por navegador, en total
CHAT_GRATIS_TOTAL=2
# Techo diario de preguntas gratis por conexión (IP con sal diaria), aunque se borren cookies
CHAT_GRATIS_POR_IP_DIA=6
# Tope diario de gasto de las preguntas GRATIS (USD). Al llegar, se pausan hasta mañana
CHAT_DAILY_BUDGET_USD=1.5
# Tope diario de emergencia de las preguntas DE PAGO (USD)
CHAT_DAILY_BUDGET_PAGO_USD=25
CHAT_MAX_QUESTION_CHARS=500

# --- Bonos (spec 004). APAGADOS por defecto: ver specs/004-uso-y-bonos/activar-pagos.md ---
# Con PAGOS_ACTIVOS=1 solo se cobra si están TODAS las variables de abajo
PAGOS_ACTIVOS=0
# Solo en desarrollo: «simulada» prueba el flujo sin Stripe (en producción se ignora)
PAGOS_PASARELA=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Datos del titular (aviso legal, LSSI art. 10): se publican en /condiciones
TITULAR_NOMBRE=
TITULAR_NIF=
TITULAR_EMAIL=
# Antibots opcional (Cloudflare Turnstile): vacío = desactivado
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Secreto para el HMAC de IPs (cadena aleatoria larga)
IP_HASH_SECRET=

# --- Web ---
# URL pública (con https://). Con dominio propio, la URL de Railway redirige aquí (salvo /api)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_REPO=paablofraga4/comparador_partidos_politicos_espana
# Google Search Console → propiedad «Prefijo de URL» → «Etiqueta HTML»: solo el valor de content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
