# COPIA (no renombres) este fichero a .env y rellena los valores. NUNCA subas .env al repo.
# En producción, estas variables se configuran en Railway (servicio web) y GitHub Secrets (CI).

# --- OpenAI ---
OPENAI_API_KEY=
# Los modelos y precios están en config/models.env (versionado, no secreto).
# Solo si quieres sobrescribirlos en local, descomenta y rellena:
# OPENAI_MODEL_ANALYSIS=
# OPENAI_MODEL_CHAT=
# OPENAI_MODEL_FAST=
# OPENAI_EMBEDDING_MODEL=

# --- Base de datos (Railway Postgres con pgvector) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comparador

# --- Chat: uso justo y coste ---
CHAT_RATE_LIMIT_PER_HOUR=20
CHAT_DAILY_BUDGET_USD=10
# Secreto para el HMAC de IPs (cadena aleatoria larga)
IP_HASH_SECRET=

# --- Web ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_REPO=paablofraga4/comparador_partidos_politicos_espana
