# Modelos de OpenAI de VotoClaro (NO secreto: se versiona para que los análisis sean reproducibles).
# Elegidos en la tarea T-107 (6-oct-2026) con GET /v1/models y la tabla oficial de precios
# (https://developers.openai.com/api/docs/pricing). Tu .env puede sobrescribir cualquier valor.
# Precios: USD por millón de tokens → entrada,entrada_en_caché,salida

# Análisis por tema y lectura fácil (programa completo en contexto + caché)
OPENAI_MODEL_ANALYSIS=gpt-6.1-sol
OPENAI_PRICE_ANALYSIS=2.00,0.10,10.00

# Tareas rápidas: juez de fidelidad, reranking del chat
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_PRICE_FAST=0.10,0.01,0.50

# Chat (provisional: se confirma con los evals de la spec 003)
OPENAI_MODEL_CHAT=gpt-6.1-sol
OPENAI_PRICE_CHAT=2.00,0.10,10.00

# Embeddings (búsqueda híbrida del chat)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
